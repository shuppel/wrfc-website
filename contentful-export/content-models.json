          "name": "Content",
          "type": "RichText",
          "localized": false,
          "required": true,
          "validations": [
            {
              "enabledMarks": [
                "bold",
                "italic",
                "underline",
                "code"
              ],
              "message": "Only bold, italic, underline, and code marks are allowed"
            },
            {
              "enabledNodeTypes": [
                "heading-1",
                "heading-2",
                "heading-3",
                "heading-4",
                "heading-5",
                "heading-6",
                "ordered-list",
                "unordered-list",
                "hr",
                "blockquote",
                "embedded-asset-block",
                "embedded-entry-block",
                "hyperlink",
                "entry-hyperlink",
                "asset-hyperlink",
                "embedded-entry-inline"
              ],
              "message": "Only valid content types are allowed"
            }
          ],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "author",
          "name": "Author",
          "type": "Link",
          "localized": false,
          "required": false,
          "validations": [
            {
              "linkContentType": [
                "author"
              ]
